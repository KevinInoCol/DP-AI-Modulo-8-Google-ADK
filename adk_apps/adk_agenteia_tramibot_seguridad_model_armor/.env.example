# ============================================================
# GEMINI (modelo del agente) — elige cómo te conectas
# ------------------------------------------------------------
#   api_key → Gemini API (Google AI Studio) con GOOGLE_API_KEY
#   vertex  → Vertex AI con GOOGLE_CLOUD_PROJECT + GOOGLE_CLOUD_LOCATION y
#             Application Default Credentials (ADC). Tu usuario (local) o la SA de
#             Cloud Run necesita el rol Vertex AI User (roles/aiplatform.user).
#
# Credenciales de Google Cloud (Vertex AI y Model Armor): SOLO ADC, sin llaves JSON.
#   Local:     gcloud auth application-default login
#              gcloud auth application-default set-quota-project <PROYECTO>
#   Cloud Run: la cuenta de servicio del servicio (--service-account), con sus roles.
# ============================================================
GEMINI_AUTH_MODE=api_key

# Modo api_key — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Modo vertex
GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
# Los modelos Gemini más nuevos suelen estar en "global"; si usas una región
# (us-central1…) verifica que el modelo esté disponible ahí.
GOOGLE_CLOUD_LOCATION=global

# Modelo (sobrescribe model_config/model.yaml)
GEMINI_MODEL=gemini-3.5-flash
# Nivel de razonamiento (sobrescribe thinking_level de model.yaml): minimal | low | medium | high
# GEMINI_THINKING_LEVEL=low
# Modelo del LLM-as-a-Judge (evaluation/llm_judge.py)
JUDGE_MODEL=gemini-3.5-flash

# ============================================================
# OpenAI — SOLO para los embeddings del RAG
# ------------------------------------------------------------
# La colección de Qdrant se creó con text-embedding-ada-002; la consulta
# tiene que vectorizarse con el mismo modelo.
# ============================================================
OPENAI_API_KEY=sk-proj-...

# Memoria: sesiones de ADK en PostgreSQL (Supabase, Session pooler :5432)
DB_USER=postgres.<project-ref>
DB_PASSWORD=
DB_HOST=aws-1-us-east-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# Esquema donde ADK crea sus tablas (sessions, events, app_states, user_states)
DB_SCHEMA=tramibot_adk

# Base de Conocimiento (RAG · Qdrant)
QDRANT_URL=https://tu-servidor-qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=tenant_id_municipio_de_girardota

# Conexión a la Web (tool desactivada por defecto)
TAVILY_API_KEY=tvly-dev-...

# Variables para Chatwoot
CHATWOOT_BASE_URL=https://<tu-instancia>.easypanel.host
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_BOT_LABEL=ia-off

# Zona horaria del agente
AGENT_TIMEZONE=America/Lima

# ============================================================
# Model Armor (Google Cloud) — plugin oficial de ADK
# ------------------------------------------------------------
# Plantilla creada en Seguridad → Model Armor. Credenciales: ADC (ver arriba);
# tu usuario o la SA de Cloud Run necesita el rol Model Armor User
# (roles/modelarmor.user). No se usan llaves JSON.
# ============================================================
MODEL_ARMOR_PROJECT=tu-proyecto-gcp
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE=datapath-guardrail
# Opcional: otra plantilla para la salida (por defecto, la misma)
# MODEL_ARMOR_RESPONSE_TEMPLATE=

# Langfuse — obtén las keys en https://cloud.langfuse.com
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
# De dónde sale el system prompt: langfuse (Prompt Management) | yaml (prompt/system_prompt.yaml)
PROMPT_SOURCE=langfuse
LANGFUSE_PROMPT_NAME=Prompt-del-Agente-Tramites-Girardota

# ============================================================
# Buffer de mensajes (Redis) — Debounce de WhatsApp/Chatwoot
# ============================================================
#REDIS_URL=redis://localhost:6379/0
REDIS_HOST=
REDIS_PORT=
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false
MESSAGE_BUFFER_ENABLED=true
MESSAGE_BUFFER_WINDOW_SECONDS=15
MESSAGE_BUFFER_TTL_SECONDS=300
MESSAGE_BUFFER_SEPARATOR="\n"

# ============================================
# Frontend React (main_frontend_react.py)
# ============================================
FRONTEND_API_PORT=8001
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FRONTEND_DIST_DIR=
