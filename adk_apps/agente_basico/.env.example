# ============================================================
# GEMINI — api_key (Google AI Studio) | vertex (Vertex AI + ADC)
# ============================================================
GEMINI_AUTH_MODE=api_key
GOOGLE_API_KEY=

# Modo vertex
GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
GOOGLE_CLOUD_LOCATION=global
# Credenciales: ADC, sin llaves JSON. Rol necesario: Vertex AI User (roles/aiplatform.user)
#   Local:     gcloud auth application-default login
#              gcloud auth application-default set-quota-project <PROYECTO>
#   Cloud Run: la cuenta de servicio del servicio (--service-account)

# Modelo (sobrescribe model_config/model.yaml)
GEMINI_MODEL=gemini-3.5-flash
# Nivel de razonamiento (sobrescribe thinking_level de model.yaml): minimal | low | medium | high
# GEMINI_THINKING_LEVEL=low

# ============================================================
# Histórico: Cloud SQL (Postgres 18) multitenant con RLS — base adk_historico
# ------------------------------------------------------------
# DB_USER es el TENANT de este agente (agente_basico): Postgres solo le deja ver y
# escribir sus propias filas. Lo crea (y escribe estas 5 claves) el script:
#   python infra/cloud_sql_historico/historico_multitenant.py tenant agente_basico --env-file <este .env>
# Local: Cloud SQL Auth Proxy en 127.0.0.1:5432
#   cloud-sql-proxy datapath-kevin-inofuente:us-central1:adk-historico --port 5432
# Cloud Run: DB_HOST=/cloudsql/datapath-kevin-inofuente:us-central1:adk-historico
# ============================================================
DB_USER=agente_basico
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=adk_historico

# Zona horaria del agente
AGENT_TIMEZONE=America/Lima
