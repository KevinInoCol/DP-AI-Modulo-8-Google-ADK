# Admin de la instancia Cloud SQL (usuario postgres). Solo para historico_multitenant.py:
# los agentes NUNCA usan este usuario, cada uno tiene el suyo (subcomando `tenant`).
HISTORICO_ADMIN_USER=postgres
HISTORICO_ADMIN_PASSWORD=
# Cloud SQL Auth Proxy en local:
#   cloud-sql-proxy datapath-kevin-inofuente:us-central1:adk-historico --port 5432
HISTORICO_DB_HOST=127.0.0.1
HISTORICO_DB_PORT=5432
HISTORICO_DB_NAME=adk_historico
